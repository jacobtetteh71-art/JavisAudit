<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  AndroidManifest.xml  –  App Permissions & Configuration
  ============================================================
  UPDATE: android.permission.INTERNET has been ADDED below to
  support the new Cloud Sync feature (Firebase Auth + Firestore).
  This changes the previous offline-only guarantee described in
  the system design document (Section 8.1), which stated the app
  was "architecturally incapable of making network calls." That
  section should be revised to describe JavisAudit as
  offline-first with OPTIONAL, owner-initiated cloud sync
  instead — the app still works fully offline; INTERNET is only
  ever used when the owner signs in and taps "Sync Now" (or the
  device reconnects while already signed in).
  ============================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for Cloud Sync (Firebase Auth + Firestore). See the
         note above — this is new as of the Cloud Sync feature. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Required so local notifications survive a device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <!-- Required to read backup JSON files selected via file_picker -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <!-- Required to take a profile picture photo via image_picker.
         Gallery selection does NOT need a permission declaration here —
         Android's built-in Photo Picker (API 33+) and image_picker's own
         legacy handling cover that without extra entries. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:label="JavisAudit"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <!-- allowBackup="false": without this, Android's default is
             TRUE, which lets Auto Backup (to the owner's Google
             account) or `adb backup` copy this app's entire private
             storage off the device — including the unencrypted-at-
             the-OS-level SQLite database — completely bypassing the
             in-app PIN lock. Financial/business data has no business
             leaving the device through a channel the app itself
             never sees or controls. fullBackupContent="false" is
             belt-and-braces for the same reason on API levels that
             check it independently of allowBackup. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Splash screen theme shown while Flutter initialises -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"/>

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Required by flutter_local_notifications to receive the
             boot-completed broadcast and reschedule any pending alerts -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>

</manifest>
